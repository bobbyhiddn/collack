# Keep the build context tiny — only dist/web/ + the Dockerfile + nginx.conf
# need to ship. Everything else (source, capacitor scaffold, tests, caches,
# desktop binary) is irrelevant to serving the web bundle.

# VCS / editor
.git
.gitignore
.github
.vscode
.idea

# Source tree (not needed at runtime)
src
tests
scripts
assets
README.md
REPORT.md
FRAMEWORK-PATTERNS.md

# Other build outputs (we only want dist/web/)
dist/desktop
dist/love
capacitor

# Caches
.love_cache
.node_cache
node_modules

# OS / tmp
.DS_Store
*.swp
*.log
